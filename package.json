{
    "name": "atlasify",
    "version": "0.4.1",
    "description": "CLI and core module for atlasify texture packer using maxrects-packer & sharp",
    "type": "module",
    "main": "lib/atlasify.js",
    "types": "lib/types/atlasify.d.ts",
    "bin": "bin/cli.js",
    "ts:main": "src/atlasify.ts",
    "scripts": {
        "lint": "oxlint \"src/**/*.ts\" \"bin/**/*.js\" \"bin/**/*.cjs\"",
        "lint:fix": "oxlint --fix \"src/**/*.ts\" \"bin/**/*.js\" \"bin/**/*.cjs\"",
        "clean": "rimraf ./lib && rimraf ./dist && rimraf --glob \"./tests/artifacts/*\"",
        "prepare": "patch-package",
        "build": "tsc",
        "build:clean": "npm run clean && npm run build",
        "doc": "cd ./website && npm install && npm run build",
        "doc:clean": "rimraf ./website/build && rimraf ./website/docs/*",
        "doc:publish": "gh-pages --dotfiles=true -m \"[ci skip] Updates\" -d website/build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:coverage": "vitest run --coverage",
        "test:cli": "cd ./tests/artifacts && node ../../bin/cli.js --group-folder -astr -p 2 -m 1024,1024 --extrude 1 --trim --search-dummy --debug --save ../../assets/atlas",
        "version": "standard-version",
        "commit": "npx git-cz"
    },
    "repository": {
        "type": "git",
        "url": "git+https://soimy@github.com/soimy/atlasify.git"
    },
    "keywords": [
        "atlas",
        "atlasify",
        "sprite",
        "spritesheet",
        "bin",
        "pack",
        "packer",
        "maxrect",
        "rect"
    ],
    "author": "YM Shen <soimy@163.com> (http://github.com/soimy)",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/soimy/atlasify/issues"
    },
    "homepage": "https://github.com/soimy/atlasify#readme",
    "devDependencies": {
        "@types/mustache": "^4.2.6",
        "@types/node": "^25.3.0",
        "@vitest/coverage-v8": "^4.0.18",
        "cz-conventional-changelog": "^3.3.0",
        "gh-pages": "^6.3.0",
        "oxlint": "^1.50.0",
        "patch-package": "^8.0.1",
        "postinstall-prepare": "^2.0.0",
        "rimraf": "^6.1.3",
        "standard-version": "^9.5.0",
        "ts-node": "^10.9.2",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "@types/pixelmatch": "^5.2.6",
        "commander": "^14.0.3",
        "maxrects-packer": "^2.7.3",
        "mustache": "^4.2.0",
        "pixelmatch": "^7.1.0",
        "resource-loader": "^4.0.0-rc4",
        "sharp": "^0.34.5"
    },
    "config": {
        "commitizen": {
            "path": "cz-conventional-changelog"
        }
    }
}
